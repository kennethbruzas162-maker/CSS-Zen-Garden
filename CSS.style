
body {
  background-color:aliceblue;
  font-family: 'Courier Prime', monospace, sans-serif;
  font-size: 1.2rem;
}

.page-wrapper {
  max-width: 1500px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 2fr;
  gap: 20px;
  border-color: #000;
}

@media {
    .page-wrapper {
    grid-template-columns: 2fr 1fr;
  }
  .intro {
    grid-column: 1 / -1;
    
}
}

h1, h2, h3 {
  font-family: 'Impact', 'Arial Black', sans-serif;
  text-transform: uppercase;
  letter-spacing: 1px;
  margin-top: 0;
  color: #000;
}

h1 {
  font-size: 3.5rem;
  line-height: 0.95;
  background:#fff500;
  display: inline-block;
  padding: 10px 15px;
  border: solid black;
  box-shadow: 8px 8px;
  transform: rotate(-2deg);
}

h1:hover {
    background: #00ff66;
    color: #000;
    text-transform: lowercase;
}

h2 {
  font-size: 1.3rem;
  background:#00e5ff;
  display: inline-block;
  padding: 5px 10px;
  border: solid black;
  margin-top: 15px;
}

h3 {
  font-size: 1.8rem;
  border-bottom: black 8px 8px;
  padding-bottom: 5px;
  margin-bottom: 15px;
  background:#ff007f;
  color: #fff;
  padding: 5px 10px;
  box-shadow: 3px 3px 0px #000;
}

h3:hover {
    background: #00e5ff;
    color:#000;
}

p {
  margin-bottom: 1rem;
}

abbr {
  text-decoration:wavy;
  background:#fff500;
  padding: 0 4px;
  border: 1px solid #000;
  font-weight: bold;
}

a {
  color: #000;
  font-weight: bold;
  text-decoration: underline;
  text-decoration-thickness: 2px;
  background:#00e5ff;
  padding: 2px 4px;
  border: 1px solid #000;
  transition: all 0.1s ease;
}

a:hover {
  background:#ff007f;
  color: #fff;
  transform: translate(4px, 4px);
  box-shadow: 2px 2px 0px #000;
}

.sidebar {
  background-color: #fdf6e2;
  box-shadow: black 8px 8px;
  padding: 20px;
  margin-bottom: 25px;
}

#zen-supporting {
  background-color: #fdf6e2;
  border: solid black;
  box-shadow: black 8px 8px;
  padding: 20px;
  margin-bottom: 25px;

}
header {
  text-align: center;
  padding: 20px;
  background-color: #00ff66;
}

#zen-intro {
  display: grid;
  grid-template-columns: 1fr;
  gap: 20px;
  background:#fdf6e2;
}

#zen-summary {
  background: #fff;
  border: solid black;
  padding: 15px;
  box-shadow: black 8px 8px;
  display: grid;
  grid-template-columns: 2fr;
}

#zen-preamble {
  background: #fff;
  border: solid black;
  padding: 15px;
  box-shadow: black 8px 8px;
  display: grid;
  grid-template-columns: 2fr;
}

.sidebar {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.sidebar ul {
  list-style: none;
  padding: 0;
  margin: 0;
}

.sidebar li {
  margin-bottom: 12px;
  padding: 8px;
  background:burlywood;
  border: solid black;
  box-shadow: #000 5px 5px;

}

.sidebar li a.design-name {
  font-size: 1.1rem;
  background:#fff500;
  color: #000;
  margin-bottom: 4px;
}

footer {
  grid-column: 1 / -1;
  background:#fff500;
  border: solid black;
  box-shadow: black 8px 8px;
  padding: 15px;
  gap: 15px;
  text-align: center;
}

footer a {
  background: #fff;
  padding: 5px 12px;
  box-shadow: 3px 3px 0px #000;
  text-transform: uppercase;
  font-weight: bold;
}
footer a:hover {
  background:#ff007f;
  color: #fff;
}
